{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.elytra.default": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [
            "animation.phoenix_dark.idle"
          ],
          "transitions": [
            {
              "gliding": "query.is_gliding"
            },
            {
              "sneaking": "query.is_sneaking"
            },
            {
              "swimming": "query.is_swimming"
            },
            {
              "sleeping": "query.is_sleeping"
            }
          ]
        },
        "gliding": {
          "animations": [
            "animation.phoenix_dark.glide"
          ],
          "transitions": [
            {
              "default": "!query.is_gliding"
            },
            {
              "swimming": "query.is_swimming"
            }
          ]
        },
        "sneaking": {
          "animations": [
            "animation.phoenix_dark.sneak"
          ],
          "transitions": [
            {
              "default": "!query.is_sneaking"
            }
          ]
        },
        "swimming": {
          "animations": [
            "animation.phoenix_dark.swim"
          ],
          "transitions": [
            {
              "default": "!query.is_swimming"
            }
          ]
        },
        "sleeping": {
          "animations": [
            "animation.phoenix_dark.sleep"
          ],
          "transitions": [
            {
              "default": "!query.is_sleeping"
            }
          ]
        }
      }
    }
  }
}
